# Copia este archivo como .env y completa la URL de tu base PostgreSQL.
# .env no se sube a git.

# Base local de docker-compose.yml (desarrollo y tests):
DATABASE_URL=postgresql://comparador:comparador_local@127.0.0.1:5433/comparador

# Base en la nube (Neon o Supabase), con la URL que te da su panel:
# DATABASE_URL=postgresql://usuario:clave@servidor.neon.tech/comparador?sslmode=require

# Base para test_db.py. Siempre la local: los tests nunca usan DATABASE_URL.
TEST_DATABASE_URL=postgresql://comparador:comparador_local@127.0.0.1:5433/comparador
